<%# One update inside the stack on the forecast page. `latest` is true only for
    the newest one: every other update keeps its content readable but is muted
    and badged, so nobody mistakes an old bulletin for the current one. %>
<div id="aggiornamento-<%= forecast_update.id %>"
     class="forecast-update px-6 md:px-10 py-6 border-l-4 <%= latest ? "bg-amber-500/5 border-amber-500/40" : "bg-slate-950/40 border-slate-700/50" %>">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-3">
    <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold
      <%= latest ? "border-amber-500/40 bg-amber-500/10 text-amber-200" : "border-slate-600/50 bg-slate-500/10 text-slate-400" %>">
      <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <%= latest ? "Ultimo aggiornamento" : "Aggiornamento superato" %>
    </span>
    <span class="text-[10px] <%= latest ? "text-slate-500" : "text-slate-500 italic" %>">
      <% if !latest %>
        Sostituito da un aggiornamento più recente
      <% elsif forecast_update.active? %>
        Valido fino alle <%= I18n.l(forecast_update.valid_until, format: "%H:%M") %>
      <% else %>
        Validità scaduta il <%= I18n.l(forecast_update.valid_until, format: :short) %>
      <% end %>
    </span>
  </div>
  <div class="prose prose-invert prose-base max-w-prose mx-auto leading-relaxed prose-a:text-sky-300 prose-p:my-3
    <%= latest ? "text-slate-300 prose-headings:text-slate-100 prose-strong:text-slate-100" : "text-slate-400 prose-headings:text-slate-300 prose-strong:text-slate-300" %>">
    <% if forecast_update.short_text.present? %>
      <h3 class="mb-2 <%= latest ? "text-white" : "text-slate-300" %>"><strong>TESTO BREVE</strong></h3>
      <%= forecast_update.short_text %>
    <% end %>
    <% if forecast_update.discussion.present? %>
      <h3 class="mb-2 <%= latest ? "text-white" : "text-slate-300" %>"><strong>DISCUSSIONE</strong></h3>
      <%= forecast_update.discussion %>
    <% end %>
  </div>
  <% if forecast_update.image.attached? %>
    <div class="flex items-center justify-center bg-slate-950/30 p-4 mt-4 rounded-lg">
      <%= image_tag forecast_update.image,
            class: "w-full h-auto max-w-[600px] rounded-lg shadow-lg shadow-slate-950/50 #{"opacity-75" unless latest}",
            alt: "Aggiornamento previsione del #{I18n.l(forecast_update.created_at, format: :long)}" %>
    </div>
  <% end %>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 mt-3 text-[11px] text-slate-500">
    <p><%= forecast_update.authors %></p>
    <p>
      <time datetime="<%= forecast_update.created_at.iso8601 %>">
        <%= I18n.l(forecast_update.created_at, format: :short) %>
      </time>
      &middot; <%= time_ago_in_words(forecast_update.created_at) %> fa
    </p>
  </div>
</div>
